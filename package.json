{
  "name": "ut-tenant-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "UT Tenant Savings Dashboard — pulls Fox ESS generation/battery/grid data and serves tenant savings dashboards.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
